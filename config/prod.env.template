# Production Environment Variables Template
# Generated from Talend property file: prod_product_bluepcs_mq_listener_talend_param.prm
#
# Copy this file to .env on the edge node and fill in actual values
# DO NOT commit it to version control; chmod 600
#
# FORMAT: bare KEY=VALUE lines, NO "export" prefix. This is deliberate and
# load-bearing — systemd's EnvironmentFile= parser accepts ONLY KEY=VALUE and
# silently SKIPS any line beginning with "export", which makes every variable
# invisible to the service and fails startup with
# "Could not resolve placeholder 'OAUTH_CLIENT_SECRET'".
#
# Usage:
#   systemd    EnvironmentFile=/path/to/.env            (needs bare KEY=VALUE)
#   scripts/   handled automatically (they wrap `source` in `set -a`)
#   by hand    set -a; source .env; set +a; java -jar bridge.jar ...
#              (plain `source .env` does NOT export bare assignments)

# ============================================================================
# Supervision scripts (bridge-keepalive.sh / monitor.sh)
# ============================================================================
# Without this the scripts default to the test-env profile.
BRIDGE_PROFILE=prod

# ============================================================================
# IBM MQ Configuration
# Source: cv_MQ_* / uv_MQ_* properties
# ============================================================================
MQ_HOST=pwausxhdapp02.app.hcscint.net
MQ_PORT=3112
MQ_QUEUE_MANAGER=MQHDPP2
MQ_CHANNEL=DDA.APP.SVRCONN
MQ_QUEUE=GRP.BPCS.MULE2DDA.PROD.SUBQ
MQ_USERNAME=hdpapp
# MQ_PASSWORD is optional: set only if the queue manager requires MQCSP password
# auth (the .prm carries uv_MQ_Password, so the prod QM likely does require it).
# MQ_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# MQ SSL (optional): MQ_SSL_ENABLED=true requires the cipher suite (must match the
# channel's SSLCIPH); the truststore is scoped to the MQ connection only
# MQ_SSL_ENABLED=true
# MQ_SSL_CIPHER_SUITE=TLS_RSA_WITH_AES_256_CBC_SHA256
# MQ_SSL_TRUSTSTORE_LOCATION=/path/to/truststore.jks
# MQ_SSL_TRUSTSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# Poison-message guard (optional fallback): discard (log + audit + ack) a message
# after N delivery attempts. 0/unset = disabled. PREFERRED protection is queue-
# manager backout — ask MQ team to set BOTHRESH/BOQNAME on the input queue, which
# preserves the message. See DEPLOYMENT_CHECKLIST.md "Poison Messages".
# MQ_MAX_DELIVERY_ATTEMPTS=5

# ============================================================================
# Kafka Configuration
# Source: cv_kfk_* / uv_kafka_* properties
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=pwauslclkap02.app.hcscint.net:9093,pwauslclkap03.app.hcscint.net:9093,pwauslclkap04.app.hcscint.net:9093,pwauslclkap05.app.hcscint.net:9093,paznslclkap03.app.hcscint.net:9093,paznslclkap04.app.hcscint.net:9093,paznslclkap05.app.hcscint.net:9093,paznslclkap06.app.hcscint.net:9093,pazsslclkap01.app.hcscint.net:9093,pazsslclkap02.app.hcscint.net:9093,pazsslclkap03.app.hcscint.net:9093,pazsslclkap04.app.hcscint.net:9093
KAFKA_TOPIC=DAS_PRODUCT_PMM_PRODUCT_GOLD
# Audit topic is bridge-specific (not in the .prm) - confirm name with Kafka team
KAFKA_AUDIT_TOPIC=DAS_PRODUCT_BRIDGE_AUDIT
# The audit topic DOES NOT EXIST YET: run in log mode (audit events go to the
# dedicated audit log file, 90-day retention) until the Kafka team creates the
# topic + ACLs. THEN remove this line (or set kafka) and restart. Publishing to
# the missing topic would not break message flow (audit is best-effort) but
# would lose the audit trail and spam errors/cooldowns.
AUDIT_PUBLISHER=log
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=GSSAPI
KAFKA_KERBEROS_SERVICE_NAME=cp-kafka
KAFKA_JAAS_CONFIG_PATH=/datalakedata/prod/gold/integration/conf/product/common/prod_kafka_jaas_confluent.conf
KAFKA_TRUSTSTORE_LOCATION=/datalakedata/prod/gold/integration/conf/product/confluent_kafka/kafka.truststore-prod_2025.jks
KAFKA_TRUSTSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__
KAFKA_REQUEST_SIZE=8388608

# Kafka Keystore (optional - uncomment if mutual TLS required)
# KAFKA_KEYSTORE_LOCATION=/path/to/keystore.jks
# KAFKA_KEYSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__
# KAFKA_KEY_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# ============================================================================
# HDFS Configuration
# Source: cv_hdfs_* / uv_work_HDFS_Path / uv_archive_HDFS_Path properties
# ============================================================================
# PRDODPHA is the HA nameservice (cv_hdfs_nameservices); the namenode pair
# (pwausl4slmn04/05:8020) is resolved via HADOOP_CONF_DIR - do not pin a host here
HDFS_NAMENODE=hdfs://PRDODPHA
HDFS_BASE_PATH=/prod/work/product/bluepcs/hive/raw
HDFS_ARCHIVE_PATH=/prod/work/product/bluepcs/hive/raw/archive
HDFS_REPLICATION=3

# Kerberos authentication
HDFS_KERBEROS_ENABLED=true
HDFS_KERBEROS_PRINCIPAL=a6193139@ADHCSCINT.NET
HDFS_KERBEROS_KEYTAB=/etc/security/keytabs/a6193139.keytab
HDFS_NAMENODE_PRINCIPAL=nn/_HOST@ADHCSCINT.NET
HDFS_RESOURCEMANAGER_PRINCIPAL=rm/_HOST@ADHCSCINT.NET

# Retention for scripts/hdfs-landing-cleanup.sh (daily cron sweep):
# landing files -> archive after N days (safety net for never-processed files),
# archive files -> deleted after M days. Defaults shown.
# LANDING_RETENTION_DAYS=7
# ARCHIVE_RETENTION_DAYS=30

# ============================================================================
# HBase Configuration (only needed if 'hbase' profile is active)
# Source: cv_hv_Host (HiveServer2 ZK discovery hosts)
# ============================================================================
HBASE_ZOOKEEPER_QUORUM=pwausl4slmn01.app.hcscint.net,pwausl4slmn02.app.hcscint.net,pwausl4slmn03.app.hcscint.net
HBASE_ZOOKEEPER_PORT=2181
HBASE_ZNODE_PARENT=/hbase
HBASE_LEDGER_TABLE=bridge_ledger

# ============================================================================
# Marketing Plan API Configuration
# Source: uv_planinfo_api_url, uv_api_* properties
# ============================================================================
API_BASE_URL=https://api-gateway-ssl-svc.hcscint.net/eps_product_catalog/v2/plans
API_TIMEOUT_SECONDS=30
API_USERNAME=a6193139
API_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# Retry budget. EVERY retry is a real API call, and a message stuck in a
# redelivery loop re-runs them on every delivery — lower this first if the API
# team reports load from a stuck message. See DEPLOYMENT_CHECKLIST.md
# "Maximum processing time per delivery (retry budget)". Defaults shown.
# API_RETRY_ATTEMPTS=3
# API_RETRY_DELAY_MS=1000

# Redelivery pacing for a message that keeps failing: (count-1) * backoff,
# capped. Raising these slows a hot loop without discarding anything.
# MQ_REDELIVERY_BACKOFF_MS=1000
# MQ_REDELIVERY_BACKOFF_MAX_MS=30000

# Kafka publish wait. Do NOT lower below max-block-ms + delivery-timeout-ms
# (60000 + 120000): a premature timeout reports failure for a record that is
# usually still delivered, producing a guaranteed duplicate on redelivery.
# Startup validation warns if this is incoherent.
# KAFKA_TIMEOUT_SECONDS=190

