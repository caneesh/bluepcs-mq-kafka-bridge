# Production Environment Variables Template
# Generated from Talend property file: prod_product_bluepcs_mq_listener_talend_param.prm
#
# Copy this file to prod.env and fill in actual values
# DO NOT commit prod.env to version control
#
# Usage: source prod.env && java -jar bridge.jar --spring.profiles.active=prod

# ============================================================================
# Supervision scripts (bridge-keepalive.sh / monitor.sh)
# ============================================================================
# Without this the scripts default to the test-env profile.
export BRIDGE_PROFILE=prod

# ============================================================================
# IBM MQ Configuration
# Source: cv_MQ_* / uv_MQ_* properties
# ============================================================================
export MQ_HOST=pwausxhdapp02.app.hcscint.net
export MQ_PORT=3112
export MQ_QUEUE_MANAGER=MQHDPP2
export MQ_CHANNEL=DDA.APP.SVRCONN
export MQ_QUEUE=GRP.BPCS.MULE2DDA.PROD.SUBQ
export MQ_USERNAME=hdpapp
# MQ_PASSWORD is optional: set only if the queue manager requires MQCSP password
# auth (the .prm carries uv_MQ_Password, so the prod QM likely does require it).
# export MQ_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# MQ SSL (optional): MQ_SSL_ENABLED=true requires the cipher suite (must match the
# channel's SSLCIPH); the truststore is scoped to the MQ connection only
# export MQ_SSL_ENABLED=true
# export MQ_SSL_CIPHER_SUITE=TLS_RSA_WITH_AES_256_CBC_SHA256
# export MQ_SSL_TRUSTSTORE_LOCATION=/path/to/truststore.jks
# export MQ_SSL_TRUSTSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# Poison-message guard (optional fallback): discard (log + audit + ack) a message
# after N delivery attempts. 0/unset = disabled. PREFERRED protection is queue-
# manager backout — ask MQ team to set BOTHRESH/BOQNAME on the input queue, which
# preserves the message. See DEPLOYMENT_CHECKLIST.md "Poison Messages".
# export MQ_MAX_DELIVERY_ATTEMPTS=5

# ============================================================================
# Kafka Configuration
# Source: cv_kfk_* / uv_kafka_* properties
# ============================================================================
export KAFKA_BOOTSTRAP_SERVERS=pwauslclkap02.app.hcscint.net:9093,pwauslclkap03.app.hcscint.net:9093,pwauslclkap04.app.hcscint.net:9093,pwauslclkap05.app.hcscint.net:9093,paznslclkap03.app.hcscint.net:9093,paznslclkap04.app.hcscint.net:9093,paznslclkap05.app.hcscint.net:9093,paznslclkap06.app.hcscint.net:9093,pazsslclkap01.app.hcscint.net:9093,pazsslclkap02.app.hcscint.net:9093,pazsslclkap03.app.hcscint.net:9093,pazsslclkap04.app.hcscint.net:9093
export KAFKA_TOPIC=DAS_PRODUCT_PMM_PRODUCT_GOLD
# Audit topic is bridge-specific (not in the .prm) - confirm name with Kafka team
export KAFKA_AUDIT_TOPIC=DAS_PRODUCT_BRIDGE_AUDIT
# The audit topic DOES NOT EXIST YET: run in log mode (audit events go to the
# dedicated audit log file, 90-day retention) until the Kafka team creates the
# topic + ACLs. THEN remove this line (or set kafka) and restart. Publishing to
# the missing topic would not break message flow (audit is best-effort) but
# would lose the audit trail and spam errors/cooldowns.
export AUDIT_PUBLISHER=log
export KAFKA_SECURITY_PROTOCOL=SASL_SSL
export KAFKA_SASL_MECHANISM=GSSAPI
export KAFKA_KERBEROS_SERVICE_NAME=cp-kafka
export KAFKA_JAAS_CONFIG_PATH=/datalakedata/prod/gold/integration/conf/product/common/prod_kafka_jaas_confluent.conf
export KAFKA_TRUSTSTORE_LOCATION=/datalakedata/prod/gold/integration/conf/product/confluent_kafka/kafka.truststore-prod_2025.jks
export KAFKA_TRUSTSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__
export KAFKA_REQUEST_SIZE=8388608

# Kafka Keystore (optional - uncomment if mutual TLS required)
# export KAFKA_KEYSTORE_LOCATION=/path/to/keystore.jks
# export KAFKA_KEYSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__
# export KAFKA_KEY_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# ============================================================================
# HDFS Configuration
# Source: cv_hdfs_* / uv_work_HDFS_Path / uv_archive_HDFS_Path properties
# ============================================================================
# PRDODPHA is the HA nameservice (cv_hdfs_nameservices); the namenode pair
# (pwausl4slmn04/05:8020) is resolved via HADOOP_CONF_DIR - do not pin a host here
export HDFS_NAMENODE=hdfs://PRDODPHA
export HDFS_BASE_PATH=/prod/work/product/bluepcs/hive/raw
export HDFS_ARCHIVE_PATH=/prod/work/product/bluepcs/hive/raw/archive
export HDFS_REPLICATION=3

# Kerberos authentication
export HDFS_KERBEROS_ENABLED=true
export HDFS_KERBEROS_PRINCIPAL=a6193139@ADHCSCINT.NET
export HDFS_KERBEROS_KEYTAB=/etc/security/keytabs/a6193139.keytab
export HDFS_NAMENODE_PRINCIPAL=nn/_HOST@ADHCSCINT.NET
export HDFS_RESOURCEMANAGER_PRINCIPAL=rm/_HOST@ADHCSCINT.NET

# Retention for scripts/hdfs-landing-cleanup.sh (daily cron sweep):
# landing files -> archive after N days (safety net for never-processed files),
# archive files -> deleted after M days. Defaults shown.
# export LANDING_RETENTION_DAYS=7
# export ARCHIVE_RETENTION_DAYS=30

