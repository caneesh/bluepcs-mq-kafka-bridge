OAUTH_CLIENT_ID=__REPLACE_WITH_ACTUAL_CLIENT_ID__
OAUTH_CLIENT_SECRET=__REPLACE_WITH_ACTUAL_SECRET__
OAUTH_SCOPE="openid permissions profile"

