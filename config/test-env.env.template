# ============================================================================
# PMM bridge (mq-pmm-bridge) - SEPARATE deployment directory and .env
# ============================================================================
# The PMM bridge is a second JVM with its own checkout/.env. These PMM_* names
# exist so that copying a PMM+ .env can never make the PMM bridge consume the
# PMM+ queue or write into the PMM+ landing directory: they have NO defaults.
# Shared infrastructure (MQ host/QM/channel, Kafka audit, HDFS namenode/Kerberos,
# OAUTH_CLIENT_ID/SECRET, API_USERNAME/PASSWORD) keeps the same names as above.
# PMM_MQ_QUEUE=
# PMM_HDFS_BASE_PATH=
# PMM_API_URL=
# PMM_TEMPLATE_LOCATION=file:/path/to/pmm-request-template.xml
# XPath 1.0 expressions - single-quote them (they contain [ ] / @ characters)
# PMM_XPATH_VALUE1='/PmmMessage/Product/ProductIdentifier'
# PMM_XPATH_VALUE2='/PmmMessage/Product/EffectiveDate'
# Token endpoint for the PMM service (may equal OAUTH_TOKEN_URL)
# PMM_OAUTH_TOKEN_URL=
# Optional: PMM_SERVER_PORT=8081  PMM_WINDOW_HOURS=4  PMM_WINDOW_ZONE=UTC
#           PMM_HDFS_ERROR_PATH=  PMM_API_TIMEOUT_SECONDS=60
#           PMM_API_CONTENT_TYPE=application/xml  PMM_API_ACCEPT=application/xml
#           MQ_MAX_MESSAGE_BYTES=67108864
# Supervision of this JVM (bridge-keepalive.sh / monitor.sh / watchdog):
# BRIDGE_APP=mq-pmm-bridge
# HEALTH_URL=http://localhost:8081/actuator/health/liveness
# MONITOR_HEALTH_URL=http://localhost:8081/actuator/health
# Retention for scripts/pmm-hdfs-cleanup.sh (whole date directories):
# PMM_LANDING_RETENTION_DAYS=7
# PMM_ARCHIVE_RETENTION_DAYS=30
# Audit checks against the shared topic: ABC_PIPELINE=pmm / AUDIT_GAP_PIPELINE=pmm
