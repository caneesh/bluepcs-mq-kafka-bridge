# Test Environment Variables Template
# Generated from Talend property file (test environment)
#
# Copy this file to .env and fill in actual values
# DO NOT commit it to version control; chmod 600
#
# FORMAT: bare KEY=VALUE lines, NO "export" prefix — systemd's EnvironmentFile=
# parser accepts only KEY=VALUE and silently skips "export" lines (see
# config/prod.env.template for the full explanation).
#
# Usage:
#   scripts/   handled automatically (they wrap `source` in `set -a`)
#   by hand    set -a; source .env; set +a; java -jar bridge.jar ...

# ============================================================================
# IBM MQ Configuration (Test)
# ============================================================================
MQ_HOST=teenuslika02.app.test.hscint.net
MQ_PORT=1412
MQ_QUEUE_MANAGER=MQGPT1
MQ_CHANNEL=QDA.APP.SVRCONN
MQ_QUEUE=QDP.BPCS.MALESODA.UAT.BLOB
MQ_USERNAME=bluepcsapp
# MQ_PASSWORD is optional: the test QM authenticates by user id / channel auth;
# set only if it starts requiring MQCSP password auth
# MQ_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# Poison-message guard (optional): discard (log + audit + ack) a message after N
# delivery attempts. 0/unset = disabled. Prefer queue-manager backout (BOTHRESH/
# BOQNAME) in prod — see DEPLOYMENT_CHECKLIST.md "Poison Messages".
# MQ_MAX_DELIVERY_ATTEMPTS=5

# ============================================================================
# Kafka Configuration (Test)
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=teenuslika02.app.test.hscint.net:9093,teenuslika03.app.test.hscint.net:9093,teenuslika04.app.test.hscint.net:9093
KAFKA_TOPIC=MOCK01_PMM_PRODUCT_COLA_TEST
KAFKA_AUDIT_TOPIC=MOCK01_BRIDGE_AUDIT_TEST
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=GSSAPI
KAFKA_KERBEROS_SERVICE_NAME=kafka
KAFKA_TRUSTSTORE_LOCATION=/prod/gold/integration/conf/product/common/kafka_truststore_test.jks
KAFKA_TRUSTSTORE_PASSWORD=__REPLACE_WITH_ACTUAL_PASSWORD__

# REQUIRED for SASL_SSL/GSSAPI: JAAS file with a KafkaClient section, passed as
# -Djava.security.auth.login.config by the run scripts. Without it every script
# fails with "Failed to construct kafka producer". Either point at an existing
# shared JAAS file (prod uses /datalakedata/prod/gold/integration/conf/product/
# common/prod_kafka_jaas_confluent.conf — look for a test equivalent) or create one per
# CONFIGURATION_GUIDE.md "kafka-jaas.conf" using the e4193139 keytab.
KAFKA_JAAS_CONFIG_PATH=__REPLACE_WITH_ACTUAL_PATH__

# Audit destination: kafka publishes to KAFKA_AUDIT_TOPIC; log writes JSON lines to
# the audit log file (<logfile>-audit.jsonl, 90-day retention) instead.
# Shipped as 'log' because the audit topic is not granted yet in test — publishing to
# it fails with TopicAuthorizationException, which loses the audit trail and fills the
# application log. Remove this line once the Kafka team grants write access.
AUDIT_PUBLISHER=log

