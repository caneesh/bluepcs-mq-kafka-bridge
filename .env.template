# =============================================================================
# Environment variables for the MQ-Kafka Bridge
# =============================================================================
# Copy this file to .env and fill in the real values:
#
#   cp .env.template .env
#
# .env is gitignored — NEVER commit real credentials. The scripts under
# scripts/ source .env automatically if it exists.
#
# FORMAT: bare KEY=VALUE lines, NO "export" prefix — systemd's EnvironmentFile=
# accepts only KEY=VALUE and silently skips "export" lines, which would fail
# startup with "Could not resolve placeholder". Running java by hand needs
# `set -a; source .env; set +a` (plain `source` won't export bare assignments).
#
# QUOTING (this file is sourced by bash, so bash rules apply):
#   - simple values need no quotes:        VAR=abc123
#   - values with spaces MUST be quoted:   VAR='two words'   (unquoted breaks!)
#   - single-quote anything with special characters ($ ` !) — safest default
# =============================================================================

# --- Required secrets (test-env and prod profiles fail at startup without these)
KAFKA_TRUSTSTORE_PASSWORD=
# STS client credentials (sent as ClientID/ClientSecret headers to the token
# endpoint and the enrichment API)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# STS user credentials (JSON body of the token request; username defaults to
# a6193139 in test-env)
API_PASSWORD=
# API_USERNAME=

# STS scope header — defaults to this value in test-env; uncomment to override.
# CAUTION: a blank OAUTH_SCOPE= line overrides the default with empty and the
# STS rejects the request with "missing scope header"
# OAUTH_SCOPE='oob openid profile roles permissions'

# --- MQ password: optional in all environments — set only if the queue manager
#     requires MQCSP password auth; both test and prod may authenticate by
#     user id / channel auth alone (MQRC_NOT_AUTHORIZED 2035 on connect means
#     the QM wants a password after all)
# MQ_PASSWORD=

# --- Kafka Kerberos: path to a JAAS file containing a KafkaClient section
#     (required for SASL_SSL/GSSAPI unless KAFKA_SASL_JAAS_CONFIG is used inline)
# KAFKA_JAAS_CONFIG_PATH=/path/to/kafka-jaas.conf

# --- Optional overrides (defaults come from the active profile's YAML)
# MQ_HOST=
# MQ_PORT=
# MQ_USERNAME=
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_TOPIC=
# KAFKA_TRUSTSTORE_LOCATION=
# HDFS_NAMENODE=
# API_BASE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# API_USERNAME=
# API_PASSWORD=

# --- Feature flags
# Payloads may contain PHI/PII; enable only deliberately and never in production
# MQ_LOG_PAYLOAD=false
# Recovery scheduler is opt-in
# RECOVERY_ENABLED=false

# --- Audit gap check (scripts/audit-gap-check.sh, Control-M)
# Hive access command; for beeline see the script header for the full example
# HIVE_CMD=hive -S -e
# AUDIT_GAP_TABLE=bluepcs.bridge_audit_event
# AUDIT_GAP_THRESHOLD_MINUTES=120
# AUDIT_GAP_GRACE_MINUTES=30
# AUDIT_GAP_LOOKBACK_DAYS=2
# AUDIT_GAP_RESULT_LIMIT=50
