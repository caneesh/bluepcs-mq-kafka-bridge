# =============================================================================
# Environment variables for the MQ-Kafka Bridge
# =============================================================================
# Copy this file to .env and fill in the real values:
#
#   cp .env.template .env
#
# .env is gitignored — NEVER commit real credentials. The scripts under
# scripts/ source .env automatically if it exists.
# =============================================================================

# --- Required secrets (test-env and prod profiles fail at startup without these)
KAFKA_TRUSTSTORE_PASSWORD=
OAUTH_CLIENT_SECRET=

# --- MQ password: leave unset for the test queue manager (it authenticates by
#     user id / channel auth only); required for prod
# MQ_PASSWORD=

# --- Optional overrides (defaults come from the active profile's YAML)
# MQ_HOST=
# MQ_PORT=
# MQ_USERNAME=
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_TRUSTSTORE_LOCATION=
# HDFS_NAMENODE=
# API_BASE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# API_USERNAME=
# API_PASSWORD=

# --- Feature flags
# Payloads may contain PHI/PII; enable only deliberately and never in production
# MQ_LOG_PAYLOAD=false
# Recovery scheduler is opt-in
# RECOVERY_ENABLED=false
